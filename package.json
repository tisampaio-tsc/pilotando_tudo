{
  "name": "adriana-barbosa-landing",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/fetch-content.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "seed:user": "node scripts/seed-user.mjs",
    "seed:content": "node scripts/seed-content.mjs",
    "db:setup": "npx wrangler d1 execute adriana-cms --remote --file=db/schema.sql",
    "db:seed": "npm run seed:user && npm run seed:content && npx wrangler d1 execute adriana-cms --remote --file=db/seed-user.sql && npx wrangler d1 execute adriana-cms --remote --file=db/seed-content.sql"
  },
  "dependencies": {
    "lucide-react": "^0.460.0",
    "next": "14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250214.0",
    "@types/node": "^20.17.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.15",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3"
  }
}
